# =============================================================================
# .env.docker — Beacyn Docker environment configuration
#
# Copy this file and fill in the required values:
#   cp .env.docker .env.docker.local
#
# Then start with:
#   docker compose --env-file .env.docker.local up -d
#
# Lines marked  ← REQUIRED  must be set before starting.
# Lines marked  ← OPTIONAL  are safe to leave at their defaults.
# =============================================================================

# ── Passwords ─────────────────────────────────────────────────────────────────
# MySQL root password — used by both beacyn-mysql-1.0 and the application
MYSQL_ROOT_PASSWORD=Password@123

# ── Database ──────────────────────────────────────────────────────────────────
# The app connects as root; DB_USER / DB_PASSWORD are derived from the root creds
DB_NAME=pulseiq
INFRA_DB_NAME=bsa

# Host port where MySQL is exposed on the Docker host (avoids collision with
# a local MySQL instance running on the default 3306)
DB_EXPOSE_PORT=3316

# ── Ports ─────────────────────────────────────────────────────────────────────
BACKEND_PORT=5145
FRONTEND_PORT=7145

# ── Frontend / API URLs ───────────────────────────────────────────────────────
# VITE_API_BASE_URL is BAKED INTO the JS bundle at build time.
# • Local Docker  : leave as http://localhost:5145  (browser reaches host port)
# • Remote server : set to  http://<server-ip-or-domain>:5145
#   then rebuild  : docker compose build
VITE_API_BASE_URL=http://localhost:5145
VITE_APP_URL=http://localhost:7145

# ── SNMP ──────────────────────────────────────────────────────────────────────
SNMP_COMMUNITY=public
SNMP_TRAP_ENABLED=true
SNMP_TRAP_PORT=9162

# ── Syslog ────────────────────────────────────────────────────────────────────
SYSLOG_ENABLED=true
SYSLOG_UDP_PORT=5514
SYSLOG_TCP_PORT=5514

# ── Optional: AI observability ────────────────────────────────────────────────
OBSERVABILITY_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# ── Optional: ServiceNow integration ─────────────────────────────────────────
SNOW_INSTANCE_URL=
SNOW_USERNAME=
SNOW_PASSWORD=
SNOW_ASSIGNMENT_GROUP=
