#!/usr/bin/env bash
set -euo pipefail

CLI_VERSION="1.0.0"

# Expected to be generated by src/scripts/cli/install-beacynctl.sh
SOURCE_PATH="${BASH_SOURCE[0]}"
while [[ -h "$SOURCE_PATH" ]]; do
  SOURCE_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"
  LINK_TARGET="$(readlink "$SOURCE_PATH")"
  if [[ "$LINK_TARGET" == /* ]]; then
    SOURCE_PATH="$LINK_TARGET"
  else
    SOURCE_PATH="$SOURCE_DIR/$LINK_TARGET"
  fi
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"
if [[ "$(basename "$SCRIPT_DIR")" == "cli" && "$(basename "$(dirname "$SCRIPT_DIR")")" == "scripts" && "$(basename "$(dirname "$(dirname "$SCRIPT_DIR")")")" == "src" ]]; then
  APP_DIR="$(cd "$SCRIPT_DIR/../../.." && pwd)"
elif [[ "$(basename "$SCRIPT_DIR")" == "scripts" && "$(basename "$(dirname "$SCRIPT_DIR")")" == "src" ]]; then
  APP_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
else
  APP_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
fi
CONFIG_FILE="$APP_DIR/src/scripts/cli/.beacynctl.env"
LEGACY_CONFIG_FILE="$APP_DIR/cli/.beacynctl.env"
LEGACY_CONFIG_FILE_2="$APP_DIR/.beacynctl.env"
APP_ENV_FILE="$APP_DIR/.env"

require_config() {
  if [[ ! -f "$CONFIG_FILE" && -f "$LEGACY_CONFIG_FILE" ]]; then
    CONFIG_FILE="$LEGACY_CONFIG_FILE"
  fi
  if [[ ! -f "$CONFIG_FILE" && -f "$LEGACY_CONFIG_FILE_2" ]]; then
    CONFIG_FILE="$LEGACY_CONFIG_FILE_2"
  fi
  if [[ ! -f "$CONFIG_FILE" ]]; then
    echo "beacynctl config file not found: $CONFIG_FILE" >&2
    echo "Re-run installer to generate beacynctl configuration." >&2
    exit 1
  fi
}

load_config() {
  require_config
  # shellcheck source=/dev/null
  source "$CONFIG_FILE"
  APP_ENV_FILE="${ENV_FILE:-$APP_ENV_FILE}"
}

has_cmd() {
  command -v "$1" >/dev/null 2>&1
}

mask_value() {
  local key="$1"
  local value="$2"
  if [[ "$key" =~ (PASS|PASSWORD|KEY|TOKEN|SECRET) ]]; then
    if [[ -z "$value" ]]; then
      printf '%s' ""
    elif [[ ${#value} -le 4 ]]; then
      printf '%s' "****"
    else
      printf '%s' "${value:0:2}****${value: -2}"
    fi
  else
    printf '%s' "$value"
  fi
}

read_env_value() {
  local key="$1"
  local file="${2:-$APP_ENV_FILE}"
  [[ -f "$file" ]] || return 1
  local line
  line="$(grep -E "^${key}=" "$file" | tail -1 || true)"
  [[ -n "$line" ]] || return 1
  line="${line#*=}"
  # strip matching quotes
  if [[ "$line" == \"*\" && "$line" == *\" ]]; then
    line="${line:1:${#line}-2}"
  fi
  if [[ "$line" == \'.*\' && "$line" == *\' ]]; then
    line="${line:1:${#line}-2}"
  fi
  printf '%s' "$line"
}

upsert_env_key() {
  local file="$1"
  local key="$2"
  local value="$3"
  touch "$file"
  local escaped
  escaped="$(printf '%s' "$value" | sed 's/[\/&]/\\&/g')"
  if grep -qE "^${key}=" "$file"; then
    sed -i.bak "s/^${key}=.*/${key}=${escaped}/" "$file"
  else
    printf '%s=%s\n' "$key" "$value" >> "$file"
  fi
  rm -f "$file.bak"
}

unset_env_key() {
  local file="$1"
  local key="$2"
  [[ -f "$file" ]] || return 0
  sed -i.bak "/^${key}=/d" "$file"
  rm -f "$file.bak"
}

service_start() {
  case "$SERVICE_MANAGER" in
    launchd)
      if launchctl print "gui/$(id -u)/$PLIST_LABEL" >/dev/null 2>&1; then
        launchctl kickstart -k "gui/$(id -u)/$PLIST_LABEL"
      else
        launchctl bootstrap "gui/$(id -u)" "$PLIST_FILE"
        launchctl kickstart -k "gui/$(id -u)/$PLIST_LABEL"
      fi
      ;;
    systemd)
      sudo systemctl start "$SERVICE_NAME"
      ;;
    nohup)
      if [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
        echo "Beacyn is already running."
        return 0
      fi
      mkdir -p "$(dirname "$LOG_FILE")"
      cd "$APP_DIR"
      if [[ -f "$APP_ENV_FILE" ]]; then
        set -a
        # shellcheck source=/dev/null
        source "$APP_ENV_FILE"
        set +a
      fi
      nohup "$NPM_BIN" run start > "$LOG_FILE" 2> "$ERROR_LOG_FILE" &
      echo $! > "$PID_FILE"
      ;;
    *)
      echo "Unsupported service manager: $SERVICE_MANAGER" >&2
      return 1
      ;;
  esac
}

service_stop() {
  case "$SERVICE_MANAGER" in
    launchd)
      launchctl bootout "gui/$(id -u)/$PLIST_LABEL"
      ;;
    systemd)
      sudo systemctl stop "$SERVICE_NAME"
      ;;
    nohup)
      if [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
        kill "$(cat "$PID_FILE")"
        rm -f "$PID_FILE"
      else
        echo "Beacyn is not running."
      fi
      ;;
    *)
      echo "Unsupported service manager: $SERVICE_MANAGER" >&2
      return 1
      ;;
  esac
}

status_text() {
  local state="unknown"
  local pid=""

  case "$SERVICE_MANAGER" in
    launchd)
      if launchctl print "gui/$(id -u)/$PLIST_LABEL" >/dev/null 2>&1; then
        state="$(launchctl print "gui/$(id -u)/$PLIST_LABEL" 2>/dev/null | awk -F'= ' '/state = /{print $2; exit}')"
        pid="$(launchctl print "gui/$(id -u)/$PLIST_LABEL" 2>/dev/null | awk -F'= ' '/pid = /{print $2; exit}')"
      else
        state="unloaded"
      fi
      ;;
    systemd)
      if systemctl is-active --quiet "$SERVICE_NAME"; then
        state="active"
      else
        state="inactive"
      fi
      ;;
    nohup)
      if [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
        state="running"
        pid="$(cat "$PID_FILE")"
      else
        state="stopped"
      fi
      ;;
  esac

  local frontend_listen="no"
  local backend_listen="no"
  lsof -nP -iTCP:"$FRONTEND_PORT" -sTCP:LISTEN >/dev/null 2>&1 && frontend_listen="yes"
  lsof -nP -iTCP:"$BACKEND_PORT" -sTCP:LISTEN >/dev/null 2>&1 && backend_listen="yes"

  local frontend_http=""
  local backend_http=""
  if has_cmd curl; then
    frontend_http="$(curl -s -o /dev/null -w '%{http_code}' "$FRONTEND_URL" 2>/dev/null || true)"
    backend_http="$(curl -s -o /dev/null -w '%{http_code}' "$BACKEND_URL" 2>/dev/null || true)"
  fi

  cat <<OUT
Beacyn Platform Status
Service manager: $SERVICE_MANAGER
Service state:   ${state:-unknown}
Service PID:     ${pid:-n/a}
Frontend URL:    $FRONTEND_URL
Backend URL:     $BACKEND_URL
Frontend port:   $FRONTEND_PORT (listening: $frontend_listen)
Backend port:    $BACKEND_PORT (listening: $backend_listen)
Frontend HTTP:   ${frontend_http:-n/a}
Backend HTTP:    ${backend_http:-n/a}
Log file:        ${LOG_FILE:-n/a}
Error log:       ${ERROR_LOG_FILE:-n/a}
OUT
}

status_json() {
  local state="unknown"
  local pid=""

  case "$SERVICE_MANAGER" in
    launchd)
      if launchctl print "gui/$(id -u)/$PLIST_LABEL" >/dev/null 2>&1; then
        state="$(launchctl print "gui/$(id -u)/$PLIST_LABEL" 2>/dev/null | awk -F'= ' '/state = /{print $2; exit}')"
        pid="$(launchctl print "gui/$(id -u)/$PLIST_LABEL" 2>/dev/null | awk -F'= ' '/pid = /{print $2; exit}')"
      else
        state="unloaded"
      fi
      ;;
    systemd)
      if systemctl is-active --quiet "$SERVICE_NAME"; then
        state="active"
      else
        state="inactive"
      fi
      ;;
    nohup)
      if [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
        state="running"
        pid="$(cat "$PID_FILE")"
      else
        state="stopped"
      fi
      ;;
  esac

  local frontend_listen=false
  local backend_listen=false
  lsof -nP -iTCP:"$FRONTEND_PORT" -sTCP:LISTEN >/dev/null 2>&1 && frontend_listen=true
  lsof -nP -iTCP:"$BACKEND_PORT" -sTCP:LISTEN >/dev/null 2>&1 && backend_listen=true

  local frontend_http=""
  local backend_http=""
  if has_cmd curl; then
    frontend_http="$(curl -s -o /dev/null -w '%{http_code}' "$FRONTEND_URL" 2>/dev/null || true)"
    backend_http="$(curl -s -o /dev/null -w '%{http_code}' "$BACKEND_URL" 2>/dev/null || true)"
  fi

  cat <<JSON
{
  "serviceManager": "${SERVICE_MANAGER}",
  "serviceState": "${state:-unknown}",
  "servicePid": "${pid}",
  "frontend": {
    "url": "${FRONTEND_URL}",
    "port": ${FRONTEND_PORT},
    "listening": ${frontend_listen},
    "httpCode": "${frontend_http}"
  },
  "backend": {
    "url": "${BACKEND_URL}",
    "port": ${BACKEND_PORT},
    "listening": ${backend_listen},
    "httpCode": "${backend_http}"
  },
  "logs": {
    "out": "${LOG_FILE}",
    "err": "${ERROR_LOG_FILE}"
  }
}
JSON
}

cmd_status() {
  local json=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=true ;;
      *) echo "Unknown status option: $1" >&2; return 1 ;;
    esac
    shift
  done
  if [[ "$json" == true ]]; then
    status_json
  else
    status_text
  fi
}

cmd_health() {
  local ok=true
  lsof -nP -iTCP:"$FRONTEND_PORT" -sTCP:LISTEN >/dev/null 2>&1 || ok=false
  lsof -nP -iTCP:"$BACKEND_PORT" -sTCP:LISTEN >/dev/null 2>&1 || ok=false

  if has_cmd curl; then
    [[ "$(curl -s -o /dev/null -w '%{http_code}' "$FRONTEND_URL" 2>/dev/null || true)" == "200" ]] || ok=false
    [[ "$(curl -s -o /dev/null -w '%{http_code}' "$BACKEND_URL" 2>/dev/null || true)" == "200" ]] || ok=false
  fi

  if [[ "$ok" == true ]]; then
    echo "healthy"
    return 0
  fi

  echo "unhealthy"
  return 1
}

cmd_logs() {
  local follow=false
  local component="all"
  local tail_lines=80

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -f|--follow) follow=true ;;
      --component)
        component="${2:-}"
        shift
        ;;
      --tail)
        tail_lines="${2:-80}"
        shift
        ;;
      *)
        echo "Unknown logs option: $1" >&2
        return 1
        ;;
    esac
    shift
  done

  if [[ "$SERVICE_MANAGER" == "systemd" ]]; then
    local journal_cmd=(sudo journalctl -u "$SERVICE_NAME" --no-pager)
    [[ "$follow" == true ]] && journal_cmd+=( -f ) || journal_cmd+=( -n "$tail_lines" )
    if [[ "$component" == "all" ]]; then
      "${journal_cmd[@]}"
    else
      "${journal_cmd[@]}" | grep -i "$component" || true
    fi
    return 0
  fi

  if [[ ! -f "$LOG_FILE" ]]; then
    echo "Log file not found: $LOG_FILE" >&2
    return 1
  fi

  local reader_cmd=(cat "$LOG_FILE")
  if [[ "$follow" == true ]]; then
    reader_cmd=(tail -f "$LOG_FILE")
  else
    reader_cmd=(tail -n "$tail_lines" "$LOG_FILE")
  fi

  if [[ "$component" == "all" ]]; then
    "${reader_cmd[@]}"
  else
    "${reader_cmd[@]}" | grep -i "$component" || true
  fi
}

cmd_restart() {
  local component="all"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --component)
        component="${2:-all}"
        shift
        ;;
      *)
        echo "Unknown restart option: $1" >&2
        return 1
        ;;
    esac
    shift
  done

  if [[ "$component" != "all" ]]; then
    echo "Component-level restart is not isolated for '$SERVICE_MANAGER'; performing full restart."
  fi

  service_stop || true
  service_start
  cmd_status
}

cmd_start() {
  service_start
  cmd_status
}

cmd_stop() {
  service_stop
}

cmd_open() {
  if has_cmd open; then
    open "$FRONTEND_URL"
    open "$BACKEND_URL"
  elif has_cmd xdg-open; then
    xdg-open "$FRONTEND_URL" >/dev/null 2>&1 || true
    xdg-open "$BACKEND_URL" >/dev/null 2>&1 || true
  else
    echo "Frontend: $FRONTEND_URL"
    echo "Backend:  $BACKEND_URL"
  fi
}

cmd_config() {
  local action="${1:-list}"
  shift || true

  case "$action" in
    list)
      local scope="all"
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --env) scope="env" ;;
          --cli) scope="cli" ;;
          --all) scope="all" ;;
          *) echo "Unknown config list option: $1" >&2; return 1 ;;
        esac
        shift
      done

      if [[ "$scope" == "all" || "$scope" == "cli" ]]; then
        echo "[CLI config]"
        while IFS='=' read -r key value; do
          [[ -z "$key" || "$key" =~ ^# ]] && continue
          echo "$key=$(mask_value "$key" "$value")"
        done < "$CONFIG_FILE"
      fi

      if [[ "$scope" == "all" || "$scope" == "env" ]]; then
        echo "[App env]"
        if [[ -f "$APP_ENV_FILE" ]]; then
          while IFS='=' read -r key value; do
            [[ -z "$key" || "$key" =~ ^# ]] && continue
            echo "$key=$(mask_value "$key" "$value")"
          done < "$APP_ENV_FILE"
        else
          echo "No app env file: $APP_ENV_FILE"
        fi
      fi
      ;;

    get)
      local key="${1:-}"
      local scope="auto"
      [[ -n "$key" ]] || { echo "Usage: beacynctl config get KEY [--env|--cli]" >&2; return 1; }
      shift || true
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --env) scope="env" ;;
          --cli) scope="cli" ;;
          *) echo "Unknown config get option: $1" >&2; return 1 ;;
        esac
        shift
      done

      if [[ "$scope" == "cli" ]]; then
        read_env_value "$key" "$CONFIG_FILE" || true
      elif [[ "$scope" == "env" ]]; then
        read_env_value "$key" "$APP_ENV_FILE" || true
      else
        read_env_value "$key" "$APP_ENV_FILE" || read_env_value "$key" "$CONFIG_FILE" || true
      fi
      ;;

    set)
      local key="${1:-}"
      local value="${2:-}"
      local scope="env"
      [[ -n "$key" && $# -ge 2 ]] || { echo "Usage: beacynctl config set KEY VALUE [--env|--cli]" >&2; return 1; }
      shift 2 || true
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --env) scope="env" ;;
          --cli) scope="cli" ;;
          *) echo "Unknown config set option: $1" >&2; return 1 ;;
        esac
        shift
      done

      if [[ "$scope" == "cli" ]]; then
        upsert_env_key "$CONFIG_FILE" "$key" "$value"
      else
        upsert_env_key "$APP_ENV_FILE" "$key" "$value"
      fi
      echo "Set $key in $scope config."
      ;;

    unset)
      local key="${1:-}"
      local scope="env"
      [[ -n "$key" ]] || { echo "Usage: beacynctl config unset KEY [--env|--cli]" >&2; return 1; }
      shift || true
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --env) scope="env" ;;
          --cli) scope="cli" ;;
          *) echo "Unknown config unset option: $1" >&2; return 1 ;;
        esac
        shift
      done

      if [[ "$scope" == "cli" ]]; then
        unset_env_key "$CONFIG_FILE" "$key"
      else
        unset_env_key "$APP_ENV_FILE" "$key"
      fi
      echo "Removed $key from $scope config."
      ;;

    validate)
      cmd_validate
      ;;

    *)
      echo "Unknown config action: $action" >&2
      return 1
      ;;
  esac
}

cmd_backup() {
  local schema_only=true
  local output_dir="${APP_DIR}/backups"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --with-data) schema_only=false ;;
      --schema-only) schema_only=true ;;
      --output)
        output_dir="${2:-$output_dir}"
        shift
        ;;
      *) echo "Unknown backup option: $1" >&2; return 1 ;;
    esac
    shift
  done

  local db_host db_port db_user db_pass
  db_host="$(read_env_value DB_HOST "$APP_ENV_FILE" || echo localhost)"
  db_port="$(read_env_value DB_PORT "$APP_ENV_FILE" || echo 3306)"
  db_user="$(read_env_value DB_USER "$APP_ENV_FILE" || echo root)"
  db_pass="$(read_env_value DB_PASSWORD "$APP_ENV_FILE" || echo '')"

  mkdir -p "$output_dir"
  local ts out1 out2
  ts="$(date +%Y%m%d-%H%M%S)"
  out1="$output_dir/pulseiq-$ts.sql"
  out2="$output_dir/bsa-$ts.sql"

  local dump_args=( -h "$db_host" -P "$db_port" -u "$db_user" )
  [[ -n "$db_pass" ]] && dump_args+=( -p"$db_pass" )
  [[ "$schema_only" == true ]] && dump_args+=( --no-data )

  mysqldump "${dump_args[@]}" pulseiq > "$out1"
  mysqldump "${dump_args[@]}" bsa > "$out2"

  echo "Backup completed:"
  echo "- $out1"
  echo "- $out2"
}

cmd_snapshot() {
  local output_dir="${APP_DIR}/snapshots"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --output)
        output_dir="${2:-$output_dir}"
        shift
        ;;
      *) echo "Unknown snapshot option: $1" >&2; return 1 ;;
    esac
    shift
  done

  mkdir -p "$output_dir"
  local ts dir archive
  ts="$(date +%Y%m%d-%H%M%S)"
  dir="$output_dir/snapshot-$ts"
  archive="$output_dir/snapshot-$ts.tar.gz"
  mkdir -p "$dir"

  cmd_status --json > "$dir/status.json" || true
  if [[ -f "$LOG_FILE" ]]; then
    tail -n 200 "$LOG_FILE" > "$dir/log-tail.txt" || true
  fi
  if [[ -f "$ERROR_LOG_FILE" ]]; then
    tail -n 200 "$ERROR_LOG_FILE" > "$dir/error-log-tail.txt" || true
  fi
  if [[ -f "$APP_ENV_FILE" ]]; then
    sed -E 's/(PASSWORD|KEY|TOKEN|SECRET)=.*/\1=****/g' "$APP_ENV_FILE" > "$dir/env-sanitized.txt"
  fi

  tar -czf "$archive" -C "$output_dir" "snapshot-$ts"
  rm -rf "$dir"
  echo "Snapshot created: $archive"
}

cmd_migrate() {
  cd "$APP_DIR"
  "$NPM_BIN" run initdb
}

cmd_validate() {
  local ok=true

  [[ -f "$APP_DIR/package.json" ]] || { echo "Missing package.json in $APP_DIR"; ok=false; }
  [[ -f "$APP_ENV_FILE" ]] || { echo "Missing env file: $APP_ENV_FILE"; ok=false; }
  [[ -f "$APP_DIR/src/scripts/start.ts" ]] || { echo "Missing start script: $APP_DIR/src/scripts/start.ts"; ok=false; }

  if ! has_cmd node; then
    echo "node is not installed"
    ok=false
  fi

  if ! has_cmd "$NPM_BIN"; then
    echo "npm not available: $NPM_BIN"
    ok=false
  fi

  if [[ "$ok" == true ]]; then
    echo "Validation passed."
    return 0
  fi

  echo "Validation failed."
  return 1
}

cmd_expose() {
  cat <<TEXT
Expose options:
- Cloudflare Tunnel (recommended): https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/
- NGINX reverse proxy: https://nginx.org/en/docs/
- ngrok tunnel: https://ngrok.com/download

Current endpoints:
- Frontend: $FRONTEND_URL
- Backend:  $BACKEND_URL
TEXT
}

cmd_shell() {
  cd "$APP_DIR"
  if [[ -f "$APP_ENV_FILE" ]]; then
    set -a
    # shellcheck source=/dev/null
    source "$APP_ENV_FILE"
    set +a
  fi
  exec "${SHELL:-/bin/bash}"
}

cmd_reset_password() {
  local user="Root-user"
  local password=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --user)
        user="${2:-$user}"
        shift
        ;;
      --password)
        password="${2:-}"
        shift
        ;;
      *)
        echo "Unknown reset-password option: $1" >&2
        return 1
        ;;
    esac
    shift
  done

  if [[ -z "$password" ]]; then
    printf 'Enter new password for %s: ' "$user" >/dev/tty
    read -rs password < /dev/tty
    printf '\n' >/dev/tty
  fi

  [[ -n "$password" ]] || { echo "Password cannot be empty" >&2; return 1; }

  local hash
  if has_cmd shasum; then
    hash="$(printf '%s' "$password" | shasum -a 256 | awk '{print $1}')"
  else
    hash="$(printf '%s' "$password" | openssl dgst -sha256 | awk '{print $2}')"
  fi

  local db_host db_port db_user db_pass
  db_host="$(read_env_value DB_HOST "$APP_ENV_FILE" || echo localhost)"
  db_port="$(read_env_value DB_PORT "$APP_ENV_FILE" || echo 3306)"
  db_user="$(read_env_value DB_USER "$APP_ENV_FILE" || echo root)"
  db_pass="$(read_env_value DB_PASSWORD "$APP_ENV_FILE" || echo '')"

  mysql -h "$db_host" -P "$db_port" -u "$db_user" ${db_pass:+-p"$db_pass"} \
    pulseiq -e "UPDATE users SET password_hash='${hash}', password_updated_at=NOW() WHERE username='${user}';"

  echo "Password updated for user: $user"
}

cmd_maintenance() {
  local action="${1:-status}"
  local flag_file="$APP_DIR/.maintenance-mode"
  case "$action" in
    on)
      echo "enabled $(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$flag_file"
      echo "Maintenance mode enabled (CLI flag)."
      ;;
    off)
      rm -f "$flag_file"
      echo "Maintenance mode disabled (CLI flag)."
      ;;
    status)
      if [[ -f "$flag_file" ]]; then
        echo "Maintenance mode: ON"
        cat "$flag_file"
      else
        echo "Maintenance mode: OFF"
      fi
      ;;
    *)
      echo "Usage: beacynctl maintenance [on|off|status]" >&2
      return 1
      ;;
  esac
}

cmd_self_test() {
  echo "Running self-test..."
  cmd_validate
  cmd_health
  echo "Self-test completed."
}

cmd_doctor() {
  echo "Beacyn Doctor Report"
  echo "===================="
  cmd_status
  echo ""
  cmd_validate || true
  echo ""
  echo "Disk usage:"
  df -h "$APP_DIR" | tail -1
  echo ""
  echo "Node version: $(node --version 2>/dev/null || echo 'not installed')"
  echo "NPM version:  $($NPM_BIN --version 2>/dev/null || echo 'not installed')"
  echo ""
  echo "Recent logs:"
  cmd_logs --tail 40 || true
}

cmd_version() {
  local app_version="unknown"
  if [[ -f "$APP_DIR/package.json" ]]; then
    app_version="$(node -e "console.log(require('$APP_DIR/package.json').version || 'unknown')" 2>/dev/null || echo unknown)"
  fi

  echo "beacynctl version: $CLI_VERSION"
  echo "beacyn app version: $app_version"
  echo "service manager: $SERVICE_MANAGER"
}

cmd_uninstall() {
  local yes=false
  local keep_data=false
  local remove_db=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --yes) yes=true ;;
      --keep-data) keep_data=true ;;
      --remove-db) remove_db=true ;;
      *) echo "Unknown uninstall option: $1" >&2; return 1 ;;
    esac
    shift
  done

  if [[ "$yes" != true ]]; then
    echo "Refusing uninstall without --yes"
    return 1
  fi

  service_stop || true

  case "$SERVICE_MANAGER" in
    launchd)
      rm -f "$PLIST_FILE" || true
      ;;
    systemd)
      sudo systemctl disable "$SERVICE_NAME" --now || true
      sudo rm -f "/etc/systemd/system/${SERVICE_NAME}.service" || true
      sudo systemctl daemon-reload || true
      ;;
    nohup)
      rm -f "$PID_FILE" || true
      ;;
  esac

  if [[ "$remove_db" == true ]]; then
    local db_host db_port db_user db_pass
    db_host="$(read_env_value DB_HOST "$APP_ENV_FILE" || echo localhost)"
    db_port="$(read_env_value DB_PORT "$APP_ENV_FILE" || echo 3306)"
    db_user="$(read_env_value DB_USER "$APP_ENV_FILE" || echo root)"
    db_pass="$(read_env_value DB_PASSWORD "$APP_ENV_FILE" || echo '')"

    mysql -h "$db_host" -P "$db_port" -u "$db_user" ${db_pass:+-p"$db_pass"} \
      -e "DROP DATABASE IF EXISTS pulseiq; DROP DATABASE IF EXISTS bsa;" || true
  fi

  rm -f /usr/local/bin/beacynctl "$HOME/.local/bin/beacynctl" || true

  if [[ "$keep_data" != true ]]; then
    rm -rf "$APP_DIR"
  fi

  echo "Beacyn uninstall completed."
}

cmd_audit() {
  echo "Security audit"
  echo "=============="
  if has_cmd "$NPM_BIN"; then
    (cd "$APP_DIR" && "$NPM_BIN" audit --omit=dev) || true
  fi
  echo ""
  echo "Config permissions:"
  ls -l "$APP_ENV_FILE" "$CONFIG_FILE" 2>/dev/null || true
}

cmd_cleanup() {
  local scope="all"
  local yes=false
  local include_db=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --scope) scope="${2:-all}"; shift ;;
      --yes) yes=true ;;
      --include-db) include_db=true ;;
      *) echo "Unknown cleanup option: $1" >&2; return 1 ;;
    esac
    shift
  done

  if [[ "$yes" != true ]]; then
    echo "Refusing cleanup without --yes"
    return 1
  fi

  case "$scope" in
    logs|all)
      rm -f "$LOG_FILE" "$ERROR_LOG_FILE" 2>/dev/null || true
      ;;
  esac
  case "$scope" in
    cache|all)
      rm -rf "$APP_DIR/.cache" "$APP_DIR/node_modules/.cache" 2>/dev/null || true
      ;;
  esac
  case "$scope" in
    snapshots|all)
      rm -rf "$APP_DIR/snapshots" 2>/dev/null || true
      ;;
  esac

  if [[ "$include_db" == true ]]; then
    local db_host db_port db_user db_pass
    db_host="$(read_env_value DB_HOST "$APP_ENV_FILE" || echo localhost)"
    db_port="$(read_env_value DB_PORT "$APP_ENV_FILE" || echo 3306)"
    db_user="$(read_env_value DB_USER "$APP_ENV_FILE" || echo root)"
    db_pass="$(read_env_value DB_PASSWORD "$APP_ENV_FILE" || echo '')"
    mysql -h "$db_host" -P "$db_port" -u "$db_user" ${db_pass:+-p"$db_pass"} \
      -e "DROP DATABASE IF EXISTS pulseiq; DROP DATABASE IF EXISTS bsa;" || true
  fi

  echo "Cleanup complete."
}

cmd_env() {
  # Alias wrapper around `config` with env scope by default.
  local action="${1:-list}"
  shift || true
  case "$action" in
    list) cmd_config list --env "$@" ;;
    get) cmd_config get "$@" --env ;;
    set) cmd_config set "$@" --env ;;
    unset) cmd_config unset "$@" --env ;;
    *)
      echo "Usage: beacynctl env [list|get|set|unset] ..." >&2
      return 1
      ;;
  esac
}

show_help() {
  cat <<HELP
Beacyn Platform Management CLI

Usage:
  beacynctl <command> [options]

Core:
  status [--json]
  health
  logs [--component <backend|frontend|security|all>] [--tail N] [-f|--follow]
  start
  stop
  restart [--component <backend|frontend|security|all>]
  open

Config / Env:
  config list [--env|--cli|--all]
  config get KEY [--env|--cli]
  config set KEY VALUE [--env|--cli]
  config unset KEY [--env|--cli]
  config validate
  env list|get|set|unset ...

Ops:
  backup [--schema-only|--with-data] [--output DIR]
  snapshot [--output DIR]
  migrate
  validate
  expose
  shell
  reset-password [--user USER] [--password VALUE]
  maintenance [on|off|status]
  self-test
  doctor
  version
  audit
  cleanup [--scope logs|cache|snapshots|all] [--yes] [--include-db]
  uninstall [--yes] [--keep-data] [--remove-db]

Safety defaults:
  - cleanup and uninstall require --yes
  - DB removal requires explicit --include-db or --remove-db
  - backup defaults to schema-only
HELP
}

main() {
  load_config
  local command="${1:-help}"
  shift || true

  case "$command" in
    status) cmd_status "$@" ;;
    health) cmd_health "$@" ;;
    logs) cmd_logs "$@" ;;
    start) cmd_start "$@" ;;
    stop) cmd_stop "$@" ;;
    restart) cmd_restart "$@" ;;
    open) cmd_open "$@" ;;
    config) cmd_config "$@" ;;
    env) cmd_env "$@" ;;
    backup) cmd_backup "$@" ;;
    snapshot) cmd_snapshot "$@" ;;
    migrate) cmd_migrate "$@" ;;
    validate) cmd_validate "$@" ;;
    expose) cmd_expose "$@" ;;
    shell) cmd_shell "$@" ;;
    reset-password) cmd_reset_password "$@" ;;
    maintenance) cmd_maintenance "$@" ;;
    self-test) cmd_self_test "$@" ;;
    doctor) cmd_doctor "$@" ;;
    version) cmd_version "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    audit) cmd_audit "$@" ;;
    cleanup) cmd_cleanup "$@" ;;
    help|-h|--help) show_help ;;
    *)
      echo "Unknown command: $command" >&2
      show_help >&2
      return 1
      ;;
  esac
}

main "$@"