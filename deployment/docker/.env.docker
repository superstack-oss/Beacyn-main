# =============================================================================
# .env.docker — Beacyn Docker environment
#
# Usage:
#   docker compose --env-file .env.docker up -d                   (default)
#   docker compose --env-file .env.docker --profile nginx up -d   (+ NGINX)
#   docker compose --env-file .env.docker --profile cloudflare up -d  (+ Tunnel)
#
# Lines marked ← REQUIRED must be set before starting.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=Password@123
DB_NAME=pulseiq
INFRA_DB_NAME=bsa
# Host port for MySQL (avoids clash with a local MySQL on 3306)
DB_EXPOSE_PORT=3316

# ── App ports (host) ──────────────────────────────────────────────────────────
BACKEND_PORT=5145
FRONTEND_PORT=7145

# ── Frontend / API URLs ───────────────────────────────────────────────────────
# VITE_API_BASE_URL is baked into the JS bundle at build time.
# Local:      http://localhost:5145
# NGINX:      http://localhost/api  (or your domain)
# Cloudflare: https://api.yourdomain.com
VITE_API_BASE_URL=http://localhost:5145
VITE_APP_URL=http://localhost:7145

# ── SNMP ──────────────────────────────────────────────────────────────────────
SNMP_COMMUNITY=public
SNMP_TRAP_ENABLED=true
SNMP_TRAP_PORT=9162

# ── Syslog ────────────────────────────────────────────────────────────────────
SYSLOG_ENABLED=true
SYSLOG_UDP_PORT=5514
SYSLOG_TCP_PORT=5514

# ── NGINX profile ─────────────────────────────────────────────────────────────
# Used when starting with --profile nginx
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ── Cloudflare Tunnel profile ─────────────────────────────────────────────────
# Used when starting with --profile cloudflare
# Get your token from: Cloudflare Zero Trust → Networks → Tunnels → Create tunnel
# Configure public hostname routes in the Cloudflare dashboard:
#   app.yourdomain.com  → http://app:7145   (frontend)
#   api.yourdomain.com  → http://app:5145   (backend API)
# For MySQL TCP access configure a Cloudflare Access TCP application separately.
CLOUDFLARE_TUNNEL_TOKEN=   # ← REQUIRED for cloudflare profile

# ── Optional: AI observability ────────────────────────────────────────────────
OBSERVABILITY_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# ── Optional: ServiceNow integration ─────────────────────────────────────────
SNOW_INSTANCE_URL=
SNOW_USERNAME=
SNOW_PASSWORD=
SNOW_ASSIGNMENT_GROUP=
