DB_HOST=127.0.0.1 #localhost, if your db is remote the provide the remote server details.
DB_PORT=3306
DB_USER=root
DB_PASSWORD="your-password"
DB_NAME=pulseiq
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# Hosting
VITE_API_BASE_URL=http://localhost:5145
PULSE_API_BASE_URL=http://localhost:5145

# Optional: ServiceNow incident auto-creation
SNOW_INSTANCE_URL=
SNOW_USERNAME=
SNOW_PASSWORD=
SNOW_ASSIGNMENT_GROUP=

# Optional: Observability AI provider
OBSERVABILITY_AI_ENABLED=false
OBSERVABILITY_AI_PROVIDER=openai

# OpenAI (default provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini (optional alternate provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# Optional: SNMP telemetry
SNMP_COMMUNITY=public
SNMP_STALE_AFTER_SEC=300
SNMP_RETENTION_HOURS=48
SNMP_POLL_TIMEOUT_MS=8000
SNMP_TRAP_ENABLED=true
SNMP_TRAP_BIND_HOST=0.0.0.0
SNMP_TRAP_PORT=9162

# Optional: Syslog collectors (device logs/events)
SYSLOG_ENABLED=true
SYSLOG_BIND_HOST=0.0.0.0
SYSLOG_UDP_PORT=5514
SYSLOG_TCP_PORT=5514
SYSLOG_RETENTION_HOURS=48